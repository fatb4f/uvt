return {
  {
    "folke/snacks.nvim",
    optional = true,
    keys = {
      {
        "<leader>pj",
        function()
          local root = vim.fs.root(0, {
            "justfile",
            "Justfile",
            "pyproject.toml",
            "uv.lock",
            ".git",
          }) or vim.uv.cwd()

          if vim.fn.executable("lazyjust") ~= 1 then
            vim.notify("optional tool missing: lazyjust", vim.log.levels.WARN, {
              title = "Project Commands",
            })
            return
          end

          Snacks.terminal.open({ "lazyjust", root }, { cwd = root })
        end,
        desc = "Project Commands (lazyjust)",
      },
    },
  },
}

